{
  "mcpServers": {
    "dup-policy-gate": {
      "command": "python",
      "args": ["-m", "policy_gate.mcp_server"],
      "env": {}
    },
    "dup-radar-news": {
      "command": "python",
      "args": ["-m", "radar_news_mcp"],
      "env": {
        "RADAR_BASE_URL": "http://127.0.0.1:8787"
      }
    },
    "radar-ops": {
      "command": "python",
      "args": ["-m", "radar_mcp"],
      "env": {
        "RADAR_BASE_URL": "http://127.0.0.1:8787"
      }
    }
  }
}
